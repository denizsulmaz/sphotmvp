# ─────────────────────────────────────────────────────────────────
# SPHOT Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
#
# On Vercel, set the same variables under: Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────

# ── Supabase ──  (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
# Server-only (used by API routes / webhooks to bypass RLS). NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Payments mode ──
# "mock"  → clicking Pay instantly marks the booking paid (no real charge); great for testing.
# "live"  → redirects to the real Lemon Squeezy hosted checkout (requires the vars below).
# If unset, the app auto-detects: "live" when NEXT_PUBLIC_LEMONSQUEEZY_PRODUCT_ID is present, else "mock".
NEXT_PUBLIC_PAYMENTS_MODE=mock

# ── Lemon Squeezy (only needed for live payments) ──
# Public (read in the browser to build the hosted-checkout URL):
NEXT_PUBLIC_LEMONSQUEEZY_STORE_ID=your-store-subdomain      # e.g. "sphot" → sphot.lemonsqueezy.com
NEXT_PUBLIC_LEMONSQUEEZY_PRODUCT_ID=your-reservation-fee-variant-id
# Server-only (webhook signature verification + API calls):
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret-here
LEMONSQUEEZY_API_KEY=your-api-key-here

# ─────────────────────────────────────────────────────────────────
# Local DB migration tooling (scripts/db.js) — NOT used by the app at runtime.
# Pass the DB password inline when running scripts, e.g.:
#   SUPA_PW='your-db-password' node scripts/db.js exec supabase-schema.sql
# Optional overrides (defaults target this project's session pooler):
#   SUPA_HOST, SUPA_PORT, SUPA_USER, SUPA_DB
# ─────────────────────────────────────────────────────────────────
