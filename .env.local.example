# ─────────────────────────────────────────────────────────────────
# SPHOT Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────

# Supabase — get from: supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Lemon Squeezy (For payment processing & webhooks)
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret-here
LEMONSQUEEZY_API_KEY=your-api-key-here
LEMONSQUEEZY_STORE_ID=your-store-id-here
LEMONSQUEEZY_PRODUCT_ID=your-reservation-fee-product-id-here

